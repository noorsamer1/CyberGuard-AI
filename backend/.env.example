# App
APP_NAME=CyberGuard AI
DEBUG=false
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://cyberguard:cyberguard@localhost:5432/cyberguard

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins; include your Next.js port if not 3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# LAN dev (optional): allows http://192.168.x.x:3001 etc. Clear in production.
CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}):(3000|3001|3002|3003)$

# OpenRouter (optional — AI features degrade gracefully if unset)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_DETECTION_ENABLED=true
AI_DETECTION_MIN_CONFIDENCE=0.85
AI_DETECTION_MAX_EVENTS_PER_TASK=20

# Reports storage
REPORTS_DIR=./data/reports

# Controlled Cyber Range (local Docker target only)
RANGE_ENABLED=true
RANGE_TARGET_URL=http://range-target:8088
RANGE_PUBLIC_URL=http://127.0.0.1:8088
RANGE_SHARED_SECRET=dev-range-secret-change-me

# SMTP (optional — scheduled digest PDFs are still written to REPORTS_DIR if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
