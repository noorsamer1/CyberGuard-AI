# Root monorepo ignores (see also frontend/.gitignore, backend patterns)

# OS / IDE
.DS_Store
Thumbs.db
.cursor/
.idea/

# Local documents / render scratch (do not ship)
docx_render_*/
*.docx

# Python (backend)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Env files with secrets
.env
.env.local
backend/.env

# Node (if any tooling at repo root)
node_modules/
